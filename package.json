{
  "name": "nitish-jain-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio site for Nitish Jain, filmmaker. Static HTML generated from JSON by one Node script.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:check": "node build.mjs --check",
    "build:drafts": "node build.mjs --drafts",
    "test": "node --test",
    "dev": "node build.mjs && python3 -m http.server 8000"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}
